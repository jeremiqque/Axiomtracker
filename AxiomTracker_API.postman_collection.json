{
  "info": {
    "name": "AxiomTracker API",
    "description": "API collection for testing AxiomTracker backend",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Credentials",
      "item": [
        {
          "name": "List All Credentials",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/api/credentials",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "credentials"]
            }
          }
        },
        {
          "name": "Get Single Credential",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/api/credentials/CREDENTIAL_ID_HERE",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "credentials", "CREDENTIAL_ID_HERE"]
            }
          }
        },
        {
          "name": "Create Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PE License\",\n  \"entity\": \"John Doe\",\n  \"status\": \"Active\",\n  \"type\": \"individual\",\n  \"expiryDate\": \"2025-12-31\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/credentials",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "credentials"]
            }
          }
        },
        {
          "name": "Update Credential",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Expired\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/api/credentials/CREDENTIAL_ID_HERE",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "credentials", "CREDENTIAL_ID_HERE"]
            }
          }
        },
        {
          "name": "Delete Credential",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_TOKEN_HERE",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/api/credentials/CREDENTIAL_ID_HERE",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["api", "credentials", "CREDENTIAL_ID_HERE"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:4000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "health"]
        }
      }
    }
  ]
}
